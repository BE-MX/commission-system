[Unit]
Description=Leshine Ark DeepSeek Harness Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leshine-dsh
Group=leshine-dsh
WorkingDirectory=/opt/leshine-ark/current
EnvironmentFile=/etc/leshine/ark-dsh-worker.env
Environment=PYTHONPATH=/opt/leshine-ark/current/services/dsh-agent-worker
ExecStart=/opt/leshine-ark-dsh/.venv/bin/python -m ark_dsh_worker.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/leshine-ark-dsh
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

