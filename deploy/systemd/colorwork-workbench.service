[Unit]
Description=LeShine Ark colorwork workbench (stock color chart site, wrangler/workerd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ark-colorwork
Group=ark-colorwork
WorkingDirectory=/opt/commission-system/colorwork-workbench
# wrangler 的日志/缓存落在 HOME 下
Environment=HOME=/var/lib/colorwork-workbench
# 构建产物 + 本地 D1/R2 模拟层；状态落盘到 --persist-to 目录（首次启动前需在该目录
# 应用 drizzle 迁移，见 colorwork-workbench/README.md「生产部署」）。
ExecStart=/usr/bin/npx wrangler dev --config wrangler.prod.jsonc --port 8787 --ip 127.0.0.1 --persist-to /var/lib/colorwork-workbench/state
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
