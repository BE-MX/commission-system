# ── 应用环境 ──────────────────────────────────────────
# development / production. production 模式下会强校验下方关键配置
APP_ENV=development

# ── 提成系统数据库（读写）──────────────────────────────
COMMISSION_DB_HOST=localhost
COMMISSION_DB_PORT=3306
COMMISSION_DB_USER=commission
COMMISSION_DB_PASSWORD=changeme
COMMISSION_DB_NAME=commission_db

# ── 业务数据库（只读，同一RDS实例）──────────────────────
BUSINESS_DB_NAME=lsordertest

# ── DHL API ──────────────────────────────────────────
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_API_ENV=test

# ── FedEx API ────────────────────────────────────────
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_SANDBOX=false

# ── Tracking poll config ─────────────────────────────
TRACKING_POLL_BATCH_SIZE=50
STAGING_SCAN_BATCH_SIZE=100

# ── APScheduler 定时任务 ─────────────────────────────
# false 时不注册任何 cron/interval 任务,适合 worker/scheduler 分离部署
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# ── 智能获客公海背调（完成 105 迁移并验证后再开启）──────
SALES_PUBLIC_POOL_AUTO_BATCH_ENABLED=false
SALES_PUBLIC_POOL_BATCH_HOUR=7
SALES_PUBLIC_POOL_BATCH_MINUTE=30
SALES_PUBLIC_POOL_QUOTA_PER_TIER=20

# ── 设计预约模块 ──────────────────────────────────────
DESIGN_DEFAULT_DAILY_CAPACITY=3
DESIGN_REQUEST_NO_PREFIX=DSR
DESIGN_TASK_NO_PREFIX=DST

# ── 客户拍摄素材门户 ──────────────────────────────────
# media.leshine.cloud 实例的私有数据盘目录；不得由 Nginx 直接公开挂载
CUSTOMER_MEDIA_STORAGE_ROOT=/data/customer-media
CUSTOMER_MEDIA_PORTAL_ORIGIN=https://media.leshine.cloud
CUSTOMER_MEDIA_MAX_FILE_MB=500
CUSTOMER_MEDIA_MAX_BATCH_GB=20
CUSTOMER_MEDIA_SESSION_DAYS=30
CUSTOMER_MEDIA_COOKIE_NAME=leshine_media_session
CUSTOMER_MEDIA_SIGN_SECRET=

# ── JWT / Auth ───────────────────────────────────────
# production 模式下 JWT_SECRET_KEY 不能是占位符,COOKIE_SECURE 必须为 true
JWT_SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────
# 逗号分隔的域名列表。production 模式下不允许含 localhost
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000

# ── AI 加密 ──────────────────────────────────────────
# AES-256-GCM 加密 AI Provider 的 api_key。production 模式下必须显式配置
ARK_AI_ENCRYPTION_KEY=

# ── 薪资 PII 加密（身份证 / 银行卡）───────────────────
# **没配就建不了薪资档案**（pii.py 直接抛错，不回落占位密钥）。
# 开发机与生产共用同一套 RDS，两边必须配完全相同的值：
# 值不同 → 同一张身份证算出不同 HMAC → 唯一约束失效、社保导入匹配全空。
# 生成：python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ARK_SALARY_ENCRYPTION_KEY=
ARK_SALARY_HASH_KEY=

# ── ACCIO WORK 导入接口 ──────────────────────────────
# 后端读取 INSIGHT_IMPORT_API_KEY；插件侧 ARK_IMPORT_API_KEY 必须填同一串值。
INSIGHT_IMPORT_API_KEY=

# ── 钉钉 Webhook 机器人（群消息推送）──────────────────
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN_HERE
DINGTALK_WEBHOOK_SECRET=

# ── 采购节钉钉群（独立机器人，禁止复用告警群）──────────
FESTIVAL_DINGTALK_WEBHOOK_URL=
FESTIVAL_DINGTALK_WEBHOOK_SECRET=
# 运行后端的服务器访问大屏静态页/API 的同源入口；办公室本机后端 8001（8002 是云端 frps 端口）。
FESTIVAL_SCREENSHOT_BASE_URL=http://127.0.0.1:8001
# 留空会自动发现 Edge/Chrome；自动发现失败时填浏览器绝对路径。
FESTIVAL_BROWSER_EXECUTABLE=

# ── 钉钉企业内部应用（审批、工作通知）──────────────────
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=

# ── 钉钉回调 ─────────────────────────────────────────
DINGTALK_CALLBACK_AES_KEY=
DINGTALK_CALLBACK_TOKEN=

# ── WhatsApp Connector ───────────────────────────────
# 独立 WhatsApp Web 客户端服务地址，例如 http://127.0.0.1:8787
WHATSAPP_CONNECTOR_BASE_URL=
WHATSAPP_CONNECTOR_API_KEY=
WHATSAPP_CONNECTOR_TIMEOUT_SECONDS=30
WHATSAPP_AUTO_SYNC_ENABLED=true
WHATSAPP_AUTO_SYNC_INTERVAL_MINUTES=5
WHATSAPP_AUTO_SYNC_BATCH_SIZE=100
WHATSAPP_SYNC_MESSAGES_PER_CHAT=100

# ── WhatsApp 实时翻译扩展（修改后必须重启后端）────────────
# 变量名必须保留 WHATSAPP_TRANSLATION_ 前缀；DAILY_INPUT_CHARS 等短名不会被读取。
WHATSAPP_TRANSLATION_RATE_PER_MINUTE=100
WHATSAPP_TRANSLATION_DAILY_INPUT_CHARS=1000000
WHATSAPP_TRANSLATION_MAX_TEXT_CHARS=10000
WHATSAPP_TRANSLATION_AI_TIMEOUT_SECONDS=40

# 运行与自动化中心（外部服务仅健康探测；不要在 URL/query 中放 token）
OPERATIONS_PROBE_TIMEOUT_SECONDS=3
OPERATIONS_CACHE_TTL_SECONDS=20
OPERATIONS_ALLOWED_HEALTH_HOSTS=leshine.work,127.0.0.1,localhost
OPERATIONS_SOCIAL_MCP_HEALTH_URL=https://leshine.work/mcp/social-customer/health
OPERATIONS_SHOPIFY_HEALTH_URL=
OPERATIONS_OPENCLAW_HEALTH_URL=
# 最多 20 项；health_url 主机必须在 allowlist；custom headers 仅允许 Authorization/X-API-Key
OPERATIONS_EXTERNAL_SERVICES_JSON=
# 云端实例心跳：按 service_id + instance_id 保存随机 token 的 SHA-256；token_hashes 支持字符串或轮换期数组。
# 生成示例：python3 -c 'import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())'
# 示例：{"shopify-sync":{"leshine-shopify-01":{"token_hashes":["<sha256>"],"service_name":"Shopify 定时同步","environment":"leshine.work 云端","capabilities":["orders-sync"],"dependencies":["shopify-api"]}}}
OPERATIONS_HEARTBEAT_TOKEN_HASHES_JSON={}
OPERATIONS_HEARTBEAT_INTERVAL_SECONDS=60
OPERATIONS_HEARTBEAT_MISSED_THRESHOLD=3
OPERATIONS_HEARTBEAT_MAX_INSTANCES_PER_SERVICE=20
OPERATIONS_HEARTBEAT_RATE_LIMIT_PER_MINUTE=12
OPERATIONS_HEARTBEAT_INSTANCE_RETIRE_HOURS=24
OPERATIONS_HEARTBEAT_RETENTION_DAYS=7
OPERATIONS_JOB_RUN_RETENTION_DAYS=90
OPERATIONS_ALERT_TIMEOUT_SECONDS=10

# ── 微信小程序（生产报工）────────────────────────────
WX_MINI_APPID=
WX_MINI_SECRET=
# 二维码/小程序码 HMAC 签名密钥（流转卡 + 订单进度码共用）
QR_SIGN_SECRET=
# 密钥轮换过渡：填轮换前的旧密钥，换钥前已打印的报工卡（外贸 ARK-P / 内贸 ARK-D）
# 继续有效；免登录进度码不受它影响，只认 QR_SIGN_SECRET。
# 在制订单消化完（旧卡都报完工）后删除本行关闭兜底。
QR_SIGN_SECRET_LEGACY=
# 展会扫码上传（手机上传页免鉴权）HMAC 签名密钥，同类口子，独立密钥不复用上面的。
EXPO_UPLOAD_SIGN_SECRET=
# 订单进度小程序码指向的版本：release / trial / develop。
# 小程序正式版发布前设 trial（仅体验成员能扫开），发布后删掉回落 release。
# 注意：生成码走微信 access_token 接口，服务器出口 IP 必须在微信公众平台 IP 白名单里。
WX_MINI_ENV_VERSION=release
# AI 生图代理（可选，仅 image_service 生图链路走，文本 chat 不受影响）。
# 展会云机出口对生图中转站 SNI 阻断时配 socks5://127.0.0.1:1081（SSH 隧道借道
# 新加坡机出境，运维见 runbook「云端展会实例」节）；办公室生产留空=直连。
AI_IMAGE_PROXY=
# Agent Runtime / DSH（首次部署保持 false；migration、AI Preset、Worker 凭证就绪后再灰度）
AGENT_RUNTIME_ENABLED=false
AGENT_RUNTIME_DSH_ENABLED=false
AGENT_RUNTIME_COPILOT_ENABLED=false
AGENT_RUNTIME_REPURCHASE_ENABLED=false
AGENT_RUNTIME_SALES_SHADOW_ENABLED=false
AGENT_RUNTIME_REPURCHASE_BATCH_SIZE=20
AGENT_RUNTIME_WEB_SEARCH_ENABLED=false
AGENT_RUNTIME_BRAVE_SEARCH_API_KEY=
AGENT_RUNTIME_PUBLIC_FETCH_MAX_BYTES=1000000
AGENT_RUNTIME_WORKER_LEASE_SECONDS=180
AGENT_RUNTIME_MAX_ACTIVE_PER_USER=2
AGENT_RUNTIME_MAX_STEPS_PER_RUN=20
AGENT_RUNTIME_RUN_TIMEOUT_SECONDS=600
AGENT_RUNTIME_RAW_EVENT_RETENTION_DAYS=90
AGENT_RUNTIME_SHADOW_SAMPLE_RATE=0
AGENT_RUNTIME_DAILY_TOKEN_BUDGET=200000
AGENT_RUNTIME_WORKER_TOKEN_HASHES_JSON={}
AGENT_RUNTIME_WORKER_RUNTIMES_JSON={}
AGENT_RUNTIME_RUN_TOKEN_SECRET=
