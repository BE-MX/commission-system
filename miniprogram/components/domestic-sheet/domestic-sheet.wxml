<!-- components/domestic-sheet/domestic-sheet.wxml
     结构与 confirm-sheet（外贸）逐块对齐，只多了内贸独有的「报工数量」和参考图。
     工序清单默认折叠：点进度条才开时间轴弹层，和外贸一致。 -->
<!-- 遮罩只在「真的点在遮罩上」时才关闭：靠 e.target.id 判定，不依赖 catch 冒泡语义。
     此前点数量输入框会被当成点遮罩、整个弹层被收掉（2026-07-27 亮哥反馈）。 -->
<view class="confirm-overlay" id="dom-sheet-mask" wx:if="{{visible}}" bindtap="onOverlayTap">
  <view class="confirm-sheet" catchtap="noop">
    <view class="sheet-handle"></view>

    <view class="sheet-brand-strip">
      <text class="sheet-brand-name">莱莎健康假发</text>
      <text class="sheet-brand-sub">确认报工信息</text>
    </view>

    <scroll-view class="sheet-scroll" scroll-y>
      <!-- 产品信息 -->
      <view class="sheet-section">
        <text class="sheet-sec-label">产品信息</text>
        <view class="info-row">
          <text class="info-lbl">产品</text>
          <view class="info-val-wrap">
            <text class="info-val lg">{{item.product_name || '-'}}</text>
            <text class="tag-urgent" wx:if="{{item.order_type_label === '特单'}}">特单</text>
          </view>
        </view>
        <view class="info-row">
          <text class="info-lbl">客户</text>
          <text class="info-val">{{item.customer_name || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-lbl">所属订单</text>
          <text class="info-val" style="color:var(--text-sub)">{{item.order_no || '-'}}</text>
        </view>
        <view class="info-row" wx:if="{{item.unit_code}}">
          <text class="info-lbl">单件编号</text>
          <text class="info-val unit-code">{{item.unit_code}}</text>
        </view>
      </view>

      <!-- 报工工序 -->
      <view class="sheet-section" wx:if="{{item.report_mode !== 'unit'}}">
        <text class="sheet-sec-label">报工工序</text>
        <view class="info-row">
          <text class="info-lbl">当前工序</text>
          <text class="info-val process-tag">{{nextStep.process_name || '-'}}</text>
        </view>
        <!-- 工序清单不默认展开，点这条进度条才展开时间轴 -->
        <view class="proc-bar-wrap" bindtap="onProgressTap">
          <text class="proc-bar-label">工序进度 · 第 {{nextStep.step_order || 0}} 道 / 共 {{totalSteps}} 道 ›</text>
          <view class="proc-bar-bg">
            <view class="proc-bar-fill" style="width: {{progressPercent}}%"></view>
          </view>
        </view>
      </view>

      <view class="sheet-section unit-mode-card" wx:else>
        <text class="sheet-sec-label">逐件扫码模式</text>
        <view class="unit-mode-main">
          <text class="unit-mode-code">{{item.unit_code}}</text>
          <text class="unit-mode-qty">{{isDecision ? '本次选择 1 个结果' : '本次固定报工 1 件'}}</text>
        </view>
        <text class="unit-mode-tip">当前工序：{{nextStep.process_name || '-'}}</text>
        <text class="unit-mode-tip">每个二维码只对应这一件产品；同一道工序重复扫描会被系统拦截</text>
      </view>

      <!-- 报工数量（内贸独有：整批一键、拆批调小） -->
      <view class="sheet-section" wx:if="{{item.report_mode !== 'unit' && !isDecision}}">
        <view class="qty-head">
          <text class="sheet-sec-label" style="margin:0">报工数量</text>
          <text class="qty-max">最多 {{maxQty}} 件 · 下单 {{item.order_qty}} 件</text>
        </view>
        <!-- 整行 catch 掉 tap：输入框获得焦点的那一下绝不能冒到遮罩上去 -->
        <view class="qty-control" catchtap="noop">
          <view class="qty-btn {{qty <= 1 ? 'is-off' : ''}}" catchtap="onMinus">−</view>
          <input class="qty-input" type="number" confirm-type="done"
                 value="{{qtyText}}" bindinput="onInput" bindblur="onBlur" bindconfirm="onBlur" />
          <view class="qty-btn {{qty >= maxQty ? 'is-off' : ''}}" catchtap="onPlus">+</view>
          <view class="qty-all {{qty === maxQty ? 'is-on' : ''}}" catchtap="onAll">全部</view>
        </view>
        <view class="qty-tip" wx:if="{{qty < maxQty}}">
          <text class="qty-tip-dot"></text>
          <text>拆批：剩下 {{maxQty - qty}} 件留在上一道，之后扫同一张卡继续报</text>
        </view>
      </view>

      <!-- 分流判定：数量模式按结果拆数，逐件模式必须单选 -->
      <view class="sheet-section decision-section" wx:if="{{isDecision}}">
        <view class="qty-head">
          <text class="sheet-sec-label" style="margin:0">选择处理结果</text>
          <text class="qty-max" wx:if="{{item.report_mode !== 'unit'}}">已分配 {{decisionTotal}} / {{maxQty}} 件</text>
        </view>
        <view wx:if="{{item.report_mode === 'unit'}}" class="decision-unit-list">
          <view
            wx:for="{{decisionOptions}}" wx:key="code"
            class="decision-choice {{selectedOutcomeCode === item.code ? 'is-selected' : ''}}"
            data-code="{{item.code}}" bindtap="onDecisionSelect"
          >
            <view class="decision-radio"><view class="decision-radio-dot"></view></view>
            <text>{{item.label}}</text>
          </view>
        </view>
        <view wx:else class="decision-qty-list">
          <view class="decision-qty-row" wx:for="{{decisionOptions}}" wx:key="code">
            <text class="decision-label">{{item.label}}</text>
            <input
              class="decision-input" type="number" confirm-type="done" value="{{item.value}}"
              placeholder="0" data-code="{{item.code}}" data-index="{{index}}" bindinput="onDecisionInput" catchtap="noop"
            />
            <text class="decision-unit">件</text>
          </view>
        </view>
        <text class="decision-tip" wx:if="{{decisionOptions.length === 0}}">当前工序未配置可选结果，请联系管理员</text>
      </view>

      <!-- 图文要求：车间照着做活的依据，默认折叠 -->
      <view class="sheet-section" wx:if="{{hasRequirement}}">
        <view class="req-head" bindtap="onToggleReq">
          <text class="sheet-sec-label" style="margin:0">图文要求</text>
          <text class="req-toggle">{{reqOpen ? '收起 ⌃' : '展开 ⌄'}}</text>
        </view>
        <view class="req-body" wx:if="{{reqOpen}}">
          <view class="req-row" wx:if="{{item.hairstyle}}"><text class="req-lbl">发型</text><text class="req-txt">{{item.hairstyle}}</text></view>
          <view class="req-row" wx:if="{{item.color}}"><text class="req-lbl">颜色</text><text class="req-txt">{{item.color}}</text></view>
          <view class="req-row" wx:if="{{item.style_requirement}}"><text class="req-lbl">要求</text><text class="req-txt">{{item.style_requirement}}</text></view>
          <view class="req-row" wx:if="{{item.remark}}"><text class="req-lbl">备注</text><text class="req-txt">{{item.remark}}</text></view>
          <view class="img-grid" wx:if="{{images.length > 0}}">
            <image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill"
                   class="req-img" data-index="{{index}}" bindtap="onPreview" />
          </view>
        </view>
      </view>

      <view class="sheet-section" style="margin-bottom:0">
        <text class="sheet-sec-label">操作人</text>
        <view class="info-row" style="border:none;padding-bottom:0">
          <text class="info-lbl">当前用户</text>
          <text class="info-val">{{userName}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="sheet-btns">
      <button class="btn-cancel" bindtap="onCancel">取消</button>
      <button class="btn-confirm" bindtap="onConfirm" disabled="{{submitting}}">
        <text wx:if="{{submitting}}">提交中...</text>
        <block wx:else>✓ 确认报 {{isDecision ? decisionTotal : (item.report_mode === 'unit' ? 1 : qty)}} 件</block>
      </button>
    </view>
  </view>
</view>

<!-- 工序时间轴弹层（与外贸同一套结构与层级） -->
<view class="timeline-overlay" id="dom-timeline-mask" wx:if="{{showTimeline}}" bindtap="onTimelineMaskTap">
  <view class="timeline-sheet" catchtap="noop">
    <view class="sheet-handle"></view>
    <view class="timeline-header">
      <text class="timeline-title">工序进度详情</text>
      <text class="timeline-close" bindtap="onTimelineClose">✕</text>
    </view>

    <scroll-view class="timeline-body" scroll-y>
      <view class="timeline-list">
        <view class="timeline-item {{item.done ? 'done' : 'pending'}}" wx:for="{{stepList}}" wx:key="progress_id">
          <view class="tl-track">
            <view class="tl-dot"></view>
            <view class="tl-line" wx:if="{{index < stepList.length - 1}}"></view>
          </view>
          <view class="tl-content">
            <view class="tl-top">
              <text class="tl-step">第 {{item.step_order}} 道</text>
              <text class="tl-status {{item.done ? 'status-done' : 'status-pending'}}">{{item.done ? '已做完' : '进行中'}}</text>
            </view>
            <text class="tl-name">{{item.process_name}}</text>
            <!-- 内贸按数量流转，时间轴上直接给数量条 -->
            <view class="tl-qty">
              <view class="tl-qty-bar"><view class="tl-qty-fill" style="width:{{item.pct}}%"></view></view>
              <text class="tl-qty-text">已报 {{item.completed_qty}} / {{item.order_qty}} 件</text>
            </view>
            <text class="tl-skip" wx:if="{{item.skipped_qty > 0}}">自动跳过 {{item.skipped_qty}} 件</text>
            <view class="tl-detail" wx:if="{{item.last_reported_at}}">
              <text class="tl-time">{{item.last_reported_at}}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
