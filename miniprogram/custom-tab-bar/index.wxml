<!-- custom-tab-bar/index.wxml -->
<!-- 底栏：品牌黑底 + 统一线条风格图标 + 激活指示条
     激活色按模块区分：外贸=品牌黄，内贸=品牌绿（与各自页面配色一致） -->

<view class="tabbar safe-bottom" wx:if="{{!hide}}">
  <!-- 0 外贸报工：扫描框 — 四角取景框 + 扫描线 -->
  <view wx:if="{{canExport}}" class="tab-item {{selected === 0 ? 'active' : ''}}" bindtap="onTabTap" data-index="0">
    <view class="tab-icon icon-scan">
      <view class="sc-c sc-tl"></view>
      <view class="sc-c sc-tr"></view>
      <view class="sc-c sc-bl"></view>
      <view class="sc-c sc-br"></view>
      <view class="sc-line"></view>
    </view>
    <text class="tab-label">外贸报工</text>
  </view>

  <!-- 1 内贸报工：叠卡 — 两张错位卡片，对应「按数量拆批」；
       与扫描框同为 2px 描边风格，不用实心块（实心横条会读成菜单图标） -->
  <view wx:if="{{canDomestic}}" class="tab-item tab-item--domestic {{selected === 1 ? 'active' : ''}}" bindtap="onTabTap" data-index="1">
    <view class="tab-icon icon-layers">
      <view class="ly-back"></view>
      <view class="ly-front"></view>
    </view>
    <text class="tab-label">内贸报工</text>
  </view>

</view>
