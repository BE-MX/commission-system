/* pages/domestic/orders/orders.wxss */
.orders-page {
  min-height: 100vh;
  background: var(--gray-bg);
  padding-bottom: 40rpx;
}

.filter-bar {
  background: var(--card-bg);
  padding: 20rpx 24rpx 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-row { display: flex; gap: 12rpx; align-items: center; }

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: var(--gray-bg);
  font-size: 26rpx;
}

.search-btn {
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: var(--brand-green);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
}

.chip-row { white-space: nowrap; margin-top: 16rpx; }

.chip {
  display: inline-block;
  padding: 8rpx 26rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  background: var(--gray-bg);
  color: var(--text-sub);
  font-size: 24rpx;
}

.chip.is-active {
  background: var(--brand-green);
  color: #FFFFFF;
  font-weight: 600;
}

.order-list { padding: 20rpx 24rpx; }

.order-card {
  background: var(--card-bg);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.order-no { font-size: 30rpx; font-weight: 600; color: var(--text-main); }

.order-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: var(--gray-bg);
  color: var(--text-sub);
}

.status-1 { background: var(--brand-green-bg); color: var(--brand-green-ink); }
.status-2 { background: rgba(0, 196, 140, 0.12); color: var(--success); }
.status-3 { background: rgba(0, 0, 0, 0.06); color: var(--text-sub); }
.status-4 { background: rgba(229, 57, 53, 0.1); color: var(--danger); }

.order-customer { font-size: 26rpx; color: var(--text-sub); display: block; margin-bottom: 12rpx; }

.order-meta {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 14rpx;
}

.progress-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: var(--gray-bg);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: var(--brand-green);
  border-radius: 6rpx;
}

.progress-text { font-size: 22rpx; color: var(--text-muted); margin-top: 8rpx; display: block; }

.list-empty,
.list-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 明细弹层 */
.detail-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.detail-sheet {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 24rpx 40rpx;
}

.detail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-title { font-size: 32rpx; font-weight: 700; color: var(--text-main); }
.detail-close { font-size: 26rpx; color: var(--text-sub); }
.detail-sub { font-size: 26rpx; color: var(--text-sub); display: block; margin: 6rpx 0 16rpx; }

.detail-body { max-height: 60vh; }

.detail-item {
  padding: 20rpx;
  background: var(--gray-bg);
  border-radius: 14rpx;
  margin-bottom: 14rpx;
}

.detail-item-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.detail-product { font-size: 28rpx; font-weight: 600; color: var(--text-main); flex: 1; }
.detail-qty { font-size: 26rpx; color: var(--text-sub); }
.detail-current { font-size: 24rpx; color: var(--text-sub); display: block; margin-bottom: 12rpx; }

.detail-step {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.detail-step-name { flex: 1; font-size: 25rpx; color: var(--text-main); }
.detail-step-qty { font-size: 25rpx; color: var(--text-sub); }

.detail-step-wait {
  font-size: 22rpx;
  color: var(--success);
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(0, 196, 140, 0.12);
}
