/* pages/domestic/scan/scan.wxss
   整套结构与动效直接复用外贸报工页，只覆盖配色变量 ——
   两侧因此永远长一样，改版只需改一处。 */
@import "../../scan/scan.wxss";

.dom-page {
  /* 内贸品牌绿（取自 LOGO 孔雀主色 #007348 / 亮部 #0AA66F） */
  --m-accent: #0AA66F;
  --m-accent-d: #007348;
  --m-accent-l: #C9EFDF;
  --m-accent-bg: #E8F5EF;
  --m-accent-rgb: 10,166,111;
  /* 底栏 fixed 83px + 安全区，内容要让开 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 绿色实底上的文字一律白色：黄底黑字那套换成绿只有 1.29:1，读不出来。
   下面几处是外贸用 --m-ink（黑）当前景、内贸必须改白的地方。 */
.dom-page .scan-btn-text,
.dom-page .user-avatar,
.dom-page .history-btn,
.dom-page .swipe-action-text,
.dom-page .revoke-btn-confirm,
.dom-page .error-btn {
  color: #FFFFFF;
}

/* 顶栏 LOGO：外贸是文字字标，内贸用孔雀图形块（反白版） */
.dom-page .brand-logo {
  width: 52rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.dom-page .logo-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dom-page .logo-hair {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 1rpx;
}

/* 已撤销的记录淡出，但保留在列表里（撤销要留痕） */
.dom-page .record-card.is-revoked {
  opacity: 0.5;
}

.dom-page .record-card.is-revoked .record-dot {
  background: var(--text-muted);
}

/* 撤销确认弹层的强调色（外贸那处是内联样式写死金色，这里走类） */
.dom-page .revoke-bg {
  background: var(--m-accent);
  opacity: 0.15;
}

.dom-page .revoke-char {
  background: var(--m-accent);
  color: #FFFFFF;
  box-shadow: 0 4px 16px rgba(var(--m-accent-rgb), 0.5);
}

.dom-page .revoke-bar {
  background: var(--m-accent);
}
