/* pages/domestic/track/track.wxss — 订单进度（免登录）
   整份复用订单速查的样式（lk- 类），只加本页专属的顶部副标题。 */
@import "../lookup/lookup.wxss";

.tk-top { padding-bottom: 24rpx; }

.tk-sub {
  display: block;
  margin: 10rpx 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #7FE0B8;   /* 深绿导航上的次要文字用浅绿（4.84:1），同内贸报工页 */
}

.tk-detail-grid, .tk-item-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #5D6B66;
}

.tk-order-remark {
  display: block;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #DFE8E4;
  font-size: 24rpx;
  line-height: 1.5;
  color: #33433D;
}

.tk-item-detail {
  margin: 0 0 20rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F5F9F7;
}

.tk-images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.tk-image { width: 150rpx; height: 150rpx; border-radius: 12rpx; background: #EDF3F0; }
