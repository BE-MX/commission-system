/* pages/domestic/track/track.wxss — 订单进度（免登录）
   整份复用订单速查的样式（lk- 类），只加本页专属的顶部副标题。 */
@import "../lookup/lookup.wxss";

.tk-top { padding-bottom: 24rpx; }

.tk-sub {
  display: block;
  margin: 10rpx 32rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #7FE0B8;   /* 深绿导航上的次要文字用浅绿（4.84:1），同内贸报工页 */
}

.tk-item-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 0 0 20rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F5F9F7;
  font-size: 32rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
  color: #5D6B66;
}

.tk-images { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.tk-image { width: 150rpx; height: 150rpx; border-radius: 12rpx; background: #EDF3F0; }

.tk-guest { font-size: 36rpx; font-weight: 700; margin-bottom: 20rpx; overflow-wrap: anywhere; }
.tk-step { display: flex; justify-content: space-between; gap: 24rpx; font-size: 30rpx; margin-bottom: 16rpx; }
