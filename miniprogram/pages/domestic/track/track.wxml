<!-- pages/domestic/track/track.wxml — 订单进度（免登录）
     结构与配色借订单速查（lk- 类，@import 复用），去掉搜索/扫码入口 -->
<view class="lk-page">
  <view class="lk-top tk-top" style="padding-top: {{statusBarHeight}}px">
    <view class="lk-top-inner">
      <text class="lk-back"></text>
      <text class="lk-title">订单进度</text>
      <text class="lk-top-right"></text>
    </view>
    <text class="tk-sub" wx:if="{{order}}">下拉可刷新最新进度</text>
  </view>

  <!-- 加载 / 错误 -->
  <view class="lk-hint" wx:if="{{loading}}">
    <view class="lk-spin"></view><text class="lk-hint-text">查询中…</text>
  </view>
  <view class="lk-hint" wx:elif="{{errorText}}">
    <text class="lk-hint-icon">!</text>
    <text class="lk-hint-title">{{errorText}}</text>
    <text class="lk-hint-sub">请重新扫描订单进度码，或联系莱莎跟单确认</text>
  </view>

  <!-- 进度内容 -->
  <block wx:if="{{order && !loading}}">
    <view class="lk-order">
      <view class="lk-order-head">
        <text class="lk-order-no">{{order.domestic_no}}</text>
        <text class="lk-badge lk-badge--s{{order.status}}">{{order.status_label}}</text>
      </view>
      <text class="lk-order-cust">{{order.customer_name}} · 客户单号 {{order.order_no}}</text>
      <view class="lk-order-meta">
        <text>{{order.order_type_label}}</text>
        <text>下单 {{order.order_date}}</text>
        <text>总价 ¥{{order.totalAmountText}}</text>
      </view>
      <view class="tk-detail-grid">
        <text wx:if="{{order.customer_custom_code}}">客户编码：{{order.customer_custom_code}}</text>
        <text wx:if="{{order.customer_membership_level}}">会员等级：{{order.customer_membership_level}}</text>
        <text wx:if="{{order.regionText}}">地区：{{order.regionText}}</text>
        <text wx:if="{{order.customer_contact}}">联系人：{{order.customer_contact}}</text>
        <text wx:if="{{order.customer_phone}}">电话：{{order.customer_phone}}</text>
        <text wx:if="{{order.customer_address}}">地址：{{order.customer_address}}</text>
      </view>
      <text class="tk-order-remark" wx:if="{{order.remark}}">订单备注：{{order.remark}}</text>
    </view>

    <view class="lk-item" wx:for="{{order.items}}" wx:key="id" wx:for-item="it" wx:for-index="idx">
      <view class="lk-item-head">
        <text class="lk-item-name">{{it.line_code}} · {{it.product_name}}</text>
        <view class="lk-item-qty"><text class="lk-qty-num">{{it.order_qty}}</text><text class="lk-qty-unit">件</text></view>
      </view>
      <view class="lk-item-sub">
        <text class="lk-badge lk-badge--i{{it.status}}">{{it.status_label}}</text>
        <text class="lk-cur">当前：{{it.current_process}}</text>
      </view>
      <view class="tk-item-detail">
        <text wx:if="{{it.attrText}}">属性：{{it.attrText}}</text>
        <text>单价 ¥{{it.unitPriceText}} · 明细总价 ¥{{it.lineAmountText}}</text>
        <text wx:if="{{it.hairstyle}}">发型：{{it.hairstyle}}</text>
        <text wx:if="{{it.color}}">颜色：{{it.color}}</text>
        <text wx:if="{{it.style_requirement}}">发型要求：{{it.style_requirement}}</text>
        <text wx:if="{{it.remark}}">明细备注：{{it.remark}}</text>
        <text wx:if="{{it.ship_time}}">发货：{{it.ship_time}} · {{it.ship_weight}}g</text>
      </view>
      <view class="tk-images" wx:if="{{it.imageUrls.length}}">
        <image
          wx:for="{{it.imageUrls}}" wx:key="*this" wx:for-item="url"
          class="tk-image" src="{{url}}" mode="aspectFill"
          data-item="{{idx}}" data-index="{{index}}" bindtap="onPreviewImage"
        />
      </view>

      <view class="lk-steps">
        <!-- wx:for 与 wx:if 不放同一元素：block 负责循环，view 负责显隐 -->
        <block wx:for="{{it.stepView}}" wx:key="step_order" wx:for-item="step">
        <view
          class="lk-step lk-step--{{step.state}} {{index > 2 ? 'lk-step--extra' : ''}}"
          wx:if="{{index < 3 || it.expanded}}"
        >
          <view class="lk-step-rail">
            <view class="lk-step-dot"><text class="lk-step-no">{{step.step_order}}</text></view>
            <view class="lk-step-line" wx:if="{{it.expanded ? index < it.stepView.length - 1 : index < 2}}"></view>
          </view>

          <view class="lk-step-body">
            <view class="lk-step-top">
              <text class="lk-step-name">{{step.process_name}}</text>
              <text class="lk-step-state">{{step.stateText}}</text>
            </view>

            <view class="lk-bar"><view class="lk-bar-fill" style="width:{{step.pct}}%"></view></view>
            <view class="lk-step-nums">
              <text class="lk-done">已报 {{step.completed_qty}}</text>
              <text class="lk-slash">/ 共 {{step.order_qty}} 件</text>
              <text class="lk-wait" wx:if="{{step.skipped_qty > 0}}">{{step.skip_label}} {{step.skipped_qty}}</text>
              <text class="lk-wait" wx:if="{{step.reportable_qty > 0}}">待做 {{step.reportable_qty}}</text>
            </view>
          </view>
        </view>
        </block>
      </view>

      <view class="lk-more" wx:if="{{it.stepView.length > 3}}" catchtap="onToggleSteps" data-idx="{{idx}}">
        <text class="lk-more-text">{{it.expanded ? '收起工序' : '展开全部 ' + it.stepView.length + ' 道工序'}}</text>
        <view class="lk-chev {{it.expanded ? 'is-open' : ''}}"></view>
      </view>

      <view class="lk-noroute" wx:if="{{it.stepView.length === 0}}">{{it.progress_hidden ? '工序进度暂不展示' : '未配工艺路线，还没有工序进度'}}</view>
    </view>
  </block>
</view>
