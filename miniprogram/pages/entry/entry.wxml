<view class="entry-page">
  <view class="topbar" style="padding-top: {{statusBarHeight}}px"><view class="brand"><text class="brand-mark">方</text><text>莱莎方舟</text></view></view>
  <view class="welcome"><view class="welcome-text"><text class="greeting">{{greeting}}</text><text class="user-name">{{userName}}</text></view><view class="avatar">{{avatarLetter}}</view></view>
  <view class="workspace">
    <view class="section-head"><text class="section-title">我的工作台</text><text wx:if="{{!loading && !error && entries.length}}" class="count">{{entries.length}} 个功能</text></view>
    <view wx:if="{{loading}}" class="empty"><text class="empty-title">正在加载功能…</text></view>
    <view wx:elif="{{error}}" class="empty"><text class="empty-title">功能加载失败</text><text class="empty-description">请检查网络后重试</text><button class="retry" bindtap="loadEntries">重新加载</button></view>
    <view wx:elif="{{!entries.length}}" class="empty"><text class="empty-symbol">▦</text><text class="empty-title">暂未开通功能</text><text class="empty-description">请联系管理员分配功能权限
开通后即可在这里开始工作</text></view>
    <view wx:else class="navigation-grid">
      <button wx:for="{{entries}}" wx:key="id" class="nav-button nav-button--{{item.theme}}" data-id="{{item.id}}" bindtap="onEntryTap" hover-class="nav-button--pressed" hover-stay-time="80" aria-label="{{item.name}}">
        <text class="nav-arrow" aria-hidden="true">↗</text>
        <view class="visual"><image wx:if="{{item.logo}}" class="brand-logo brand-logo--{{item.theme}}" src="{{item.logo}}" mode="aspectFit"/><view wx:elif="{{item.id === 'lookup'}}" class="tool-icon lookup-icon"><view class="search-ring"></view><view class="search-handle"></view></view><view wx:else class="tool-icon shipping-icon"><view class="parcel"><text>✓</text></view></view></view>
        <text class="nav-name">{{item.name}}</text><text class="nav-description">{{item.description}}</text>
      </button>
    </view>
  </view>
  <view class="footer"><button class="logout" bindtap="onLogoutTap" hover-class="logout--pressed">退出登录</button></view>
</view>
