<!-- pages/entry/entry.wxml — 登录后的模块选择 -->
<view class="entry-page">
  <!-- 背景把金与绿两种模块色揉进同一块画布，三张卡才像一家人 -->
  <view class="bg-wash" aria-hidden="true">
    <view class="bg-blob bg-blob--gold"></view>
    <view class="bg-blob bg-blob--green"></view>
  </view>

  <view class="topbar" style="padding-top: {{statusBarHeight}}px">
    <view class="topbar-inner">
      <text class="greeting">{{greeting}}</text>
      <text class="user-name">{{userName}}</text>
    </view>
    <text class="topbar-sub">选择今天要做的事</text>
  </view>

  <view class="cards">
    <!-- 四张卡同一套骨架：LOGO/图标 区 / 标题+箭头 / 副标题，只有配色不同 -->
    <view class="card card--export {{entered ? 'is-in' : ''}}" hover-class="card--press" hover-stay-time="80" bindtap="onExportTap">
      <view class="card-glow"></view>
      <image class="card-logo" src="/assets/logo-gold.png" mode="aspectFit" />
      <view class="card-title-row">
        <text class="card-title">外贸报工</text>
        <text class="card-arrow">→</text>
      </view>
      <text class="card-sub">生产订单 · 整单流转</text>
    </view>

    <view class="card card--domestic {{entered ? 'is-in' : ''}}" hover-class="card--press" hover-stay-time="80" bindtap="onDomesticTap">
      <view class="card-glow"></view>
      <image class="card-logo" src="/assets/logo-green.png" mode="aspectFit" />
      <view class="card-title-row">
        <text class="card-title">内贸报工</text>
        <text class="card-arrow">→</text>
      </view>
      <text class="card-sub">内贸订单 · 按数量拆批</text>
    </view>

    <!-- 速查是查询工具不是报工模块，用浅色一档区分层级，但骨架与配色仍同源 -->
    <view class="card card--lookup {{entered ? 'is-in' : ''}}" hover-class="card--press" hover-stay-time="80" bindtap="onLookupTap">
      <view class="card-glow"></view>
      <view class="lookup-row">
        <view class="lookup-icon">
          <view class="lk-c lk-tl"></view><view class="lk-c lk-tr"></view>
          <view class="lk-c lk-bl"></view><view class="lk-c lk-br"></view>
          <view class="lk-mag"></view>
        </view>
        <view class="lookup-text">
          <text class="card-title">订单速查</text>
          <text class="card-sub">输入单号或扫码 · 看每道工序进度</text>
        </view>
        <text class="card-arrow">→</text>
      </view>
    </view>

    <!-- 发货检验与速查同属浅色工具档，accent 换品牌黄，与报工模块的黑金呼应 -->
    <view class="card card--shipping {{entered ? 'is-in' : ''}}" hover-class="card--press" hover-stay-time="80" bindtap="onShippingTap">
      <view class="card-glow"></view>
      <view class="lookup-row">
        <view class="shipping-icon">
          <view class="sp-box"></view>
          <view class="sp-lens"></view>
        </view>
        <view class="lookup-text">
          <text class="card-title">发货检验</text>
          <text class="card-sub">扫出库单 · 拍照留档后提交</text>
        </view>
        <text class="card-arrow">→</text>
      </view>
    </view>
  </view>

  <view class="footer">
    <text class="logout" bindtap="onLogoutTap">退出登录</text>
  </view>
</view>
