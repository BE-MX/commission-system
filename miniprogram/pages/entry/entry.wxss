/* Workbench: consistent two-column navigation; brand identity stays within each button. */
.entry-page { min-height: 100vh; box-sizing: border-box; background: var(--nav-bg); padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.topbar { padding-left: 44rpx; padding-right: 220rpx; }
.brand { min-height: 88rpx; display: flex; align-items: center; gap: 14rpx; font-size: 28rpx; font-weight: 600; }
.brand-mark { width: 46rpx; height: 46rpx; border-radius: 13rpx; background: var(--brand-green-d); color: var(--brand-yellow-l); text-align: center; line-height: 46rpx; }
.welcome { padding: 52rpx 48rpx 48rpx; display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.welcome-text { min-width: 0; }
.greeting { display: block; color: var(--text-sub); font-size: 28rpx; margin-bottom: 12rpx; }
.user-name { display: block; font-size: 52rpx; font-weight: 700; overflow-wrap: break-word; }
.avatar { width: 92rpx; height: 92rpx; border-radius: 50%; background: var(--brand-green-bg); color: var(--brand-green-d); display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.workspace { padding: 0 40rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 8rpx 28rpx; }
.section-title { font-size: 30rpx; font-weight: 600; }
.count { font-size: 24rpx; color: var(--text-sub); }
.navigation-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24rpx; }
.nav-button { position: relative; display: flex; flex-direction: column; align-items: flex-start; margin: 0; width: 100%; min-height: 312rpx; padding: 32rpx; border: 1rpx solid var(--nav-border); border-radius: 32rpx; background: var(--card-bg); color: var(--text-main); text-align: left; line-height: 1.4; }
.nav-button::after, .logout::after, .retry::after { border: 0; }
.nav-button--export { background: var(--brand-black); color: var(--brand-yellow-l); border-color: var(--brand-black); }
.nav-button--domestic { background: var(--brand-green); color: var(--card-bg); border-color: var(--brand-green); }
.nav-arrow { position: absolute; top: 30rpx; right: 28rpx; font-size: 30rpx; opacity: .65; }
.visual { height: 108rpx; display: flex; align-items: center; margin-bottom: 25rpx; }
.brand-logo { width: 210rpx; height: 90rpx; }
.brand-logo--domestic { width: 132rpx; height: 108rpx; }
.nav-name { font-size: 36rpx; font-weight: 600; }
.nav-description { font-size: 23rpx; margin-top: 12rpx; color: var(--text-sub); }
.nav-button--export .nav-description { color: var(--brand-yellow-l); opacity: .8; }
.nav-button--domestic .nav-description { color: var(--card-bg); opacity: .85; }
.nav-button--pressed { opacity: .78; }
.tool-icon { width: 84rpx; height: 84rpx; border-radius: 24rpx; position: relative; }
.lookup-icon { background: var(--nav-slate-bg); color: var(--nav-slate-ink); }
.shipping-icon { background: var(--nav-orange-bg); color: var(--nav-orange-ink); }
.search-ring { position: absolute; width: 27rpx; height: 27rpx; border: 4rpx solid currentColor; border-radius: 50%; top: 20rpx; left: 20rpx; }
.search-handle { position: absolute; width: 22rpx; height: 4rpx; background: currentColor; transform: rotate(45deg); left: 44rpx; top: 53rpx; }
.parcel { position: absolute; left: 22rpx; top: 20rpx; width: 40rpx; height: 43rpx; border: 3rpx solid currentColor; border-radius: 6rpx; text-align: center; line-height: 38rpx; font-size: 28rpx; }
.empty { padding: 76rpx 24rpx; border: 1rpx solid var(--nav-border); border-radius: 32rpx; background: var(--card-bg); text-align: center; }
.empty-symbol { display: block; font-size: 56rpx; color: var(--brand-green); margin-bottom: 24rpx; }
.empty-title { display: block; font-size: 32rpx; font-weight: 600; }
.empty-description { display: block; font-size: 26rpx; line-height: 1.8; color: var(--text-sub); margin-top: 16rpx; white-space: pre-line; }
.retry { font-size: 28rpx; background: var(--brand-green-bg); color: var(--brand-green-d); width: 220rpx; margin-top: 28rpx; }
.footer { padding: 48rpx 0 16rpx; text-align: center; }
.logout { display: inline-block; padding: 20rpx 44rpx; background: transparent; color: var(--text-sub); font-size: 26rpx; line-height: 1.5; }
.logout--pressed { color: var(--text-main); }
