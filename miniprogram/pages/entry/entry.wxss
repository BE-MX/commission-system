/* pages/entry/entry.wxss — 模块选择
   三张卡共用一套骨架（LOGO 区 / 标题+箭头 / 副标题）、一套动效，
   靠配色区分：外贸=品牌黑金，内贸=品牌绿，速查=浅色工具档。
   背景把金与绿揉进同一块画布，三张卡才像一家人而不是三个贴纸。 */

.entry-page {
  position: relative;
  min-height: 100vh;
  background: #F4F6F5;
  display: flex;
  flex-direction: column;
  padding-bottom: 24rpx;
  overflow: hidden;
}

/* ── 背景 ── */
.bg-wash {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.bg-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
}

/* 金色团在右上（呼应外贸卡），绿色团在左下（呼应内贸卡） */
.bg-blob--gold {
  top: 240rpx;
  right: -160rpx;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(245, 213, 71, 0.28) 0%, rgba(245, 213, 71, 0) 70%);
}

.bg-blob--green {
  bottom: 40rpx;
  left: -180rpx;
  width: 620rpx;
  height: 620rpx;
  background: radial-gradient(circle, rgba(10, 166, 111, 0.22) 0%, rgba(10, 166, 111, 0) 70%);
}

/* ── 顶部 ── */
.topbar {
  position: relative;
  padding: 0 40rpx 34rpx;
  background: var(--brand-black);
}

.topbar-inner {
  padding-top: 24rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.greeting { color: rgba(255, 255, 255, 0.7); font-size: 28rpx; }
.user-name { color: #FFFFFF; font-size: 40rpx; font-weight: 600; }

.topbar-sub {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
}

/* ── 卡片区 ── */
.cards {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
}

.card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;

  /* 入场：位移 + 淡入，不从 scale(0) 出现 */
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity 320ms cubic-bezier(0.23, 1, 0.32, 1),
              transform 320ms cubic-bezier(0.23, 1, 0.32, 1);
}

.card.is-in { opacity: 1; transform: translateY(0); }

/* 三张卡依次错开 70ms 入场，形成级联而不是同时砸下来 */
.card--domestic { transition-delay: 70ms; }
.card--lookup { transition-delay: 140ms; }

/* 按压反馈：只动 transform，140ms 回弹 */
.card--press {
  transform: translateY(0) scale(0.97);
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
}

.card-glow {
  position: absolute;
  top: -120rpx;
  right: -100rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  pointer-events: none;
}

/* 统一 LOGO 容纳区：金色是 2.8:1 横版字标、绿色是 1.18:1 图形块，
   等高会让绿色小成一个点，同框各自 aspectFit 视觉重量才对得上 */
.card-logo {
  width: 190rpx;
  height: 88rpx;
  margin-bottom: 26rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card-arrow { font-size: 40rpx; opacity: 0.75; }

.card-sub { margin-top: 10rpx; font-size: 26rpx; }

/* ── 外贸：品牌黑金 ── */
.card--export {
  min-height: 320rpx;
  background: linear-gradient(145deg, #262320 0%, #16150F 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.22);
}

.card--export .card-glow {
  background: radial-gradient(circle, rgba(245, 213, 71, 0.22) 0%, rgba(245, 213, 71, 0) 70%);
}

.card--export .card-title,
.card--export .card-arrow { color: var(--brand-yellow); }
.card--export .card-sub { color: rgba(255, 255, 255, 0.55); }

/* ── 内贸：品牌绿 ── */
.card--domestic {
  min-height: 320rpx;
  background: linear-gradient(145deg, #0A8A5B 0%, #00603C 100%);
  box-shadow: 0 12rpx 32rpx rgba(0, 96, 60, 0.26);
}

.card--domestic .card-glow {
  background: radial-gradient(circle, rgba(255, 255, 255, 0.20) 0%, rgba(255, 255, 255, 0) 70%);
}

.card--domestic .card-title,
.card--domestic .card-arrow { color: #FFFFFF; }
.card--domestic .card-sub { color: rgba(255, 255, 255, 0.72); }

/* ── 速查：浅色工具档（层级低一档，但骨架与绿色同源）── */
.card--lookup {
  min-height: 168rpx;
  padding: 28rpx 36rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 2rpx solid rgba(0, 115, 72, 0.14);
  box-shadow: 0 8rpx 24rpx rgba(0, 96, 60, 0.10);
}

.card--lookup .card-glow {
  background: radial-gradient(circle, rgba(10, 166, 111, 0.16) 0%, rgba(10, 166, 111, 0) 70%);
}

.card--lookup .card-title {
  font-size: 38rpx;
  color: var(--brand-green-d);
}

.card--lookup .card-arrow { color: var(--brand-green); }
.card--lookup .card-sub { color: var(--text-sub); margin-top: 6rpx; }

.lookup-row { display: flex; align-items: center; gap: 24rpx; }
.lookup-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }

/* 速查图标：取景框 + 放大镜，与报工页的扫码图标同一套线条语言 */
.lookup-icon {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  position: relative;
  border-radius: 18rpx;
  background: var(--brand-green-bg);
}

.lk-c {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid var(--brand-green);
}

.lk-tl { top: 16rpx; left: 16rpx; border-right: none; border-bottom: none; }
.lk-tr { top: 16rpx; right: 16rpx; border-left: none; border-bottom: none; }
.lk-bl { bottom: 16rpx; left: 16rpx; border-right: none; border-top: none; }
.lk-br { bottom: 16rpx; right: 16rpx; border-left: none; border-top: none; }

.lk-mag {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 26rpx;
  height: 26rpx;
  margin: -13rpx 0 0 -13rpx;
  border-radius: 50%;
  border: 4rpx solid var(--brand-green-d);
  box-sizing: border-box;
}

/* ── 底部 ── */
.footer {
  position: relative;
  text-align: center;
  padding: 8rpx 0 16rpx;
}

.logout { font-size: 26rpx; color: var(--text-muted); }
