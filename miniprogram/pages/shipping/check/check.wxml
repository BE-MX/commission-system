<!-- pages/shipping/check/check.wxml — 发货检验 -->
<view class="si-page">
  <nav-bar title="发货检验" showBack="{{true}}" />

  <!-- nav-bar 是 fixed 定位，内容区手动让出状态栏 + 44px 导航高度 -->
  <view class="si-body" style="padding-top: {{statusBarHeight + 44}}px">

    <!-- idle：大扫码按钮 -->
    <view class="si-idle {{scanActive ? '' : 'si-scan-paused'}}" wx:if="{{state === 'idle'}}">
      <view class="si-scan-btn-wrap">
        <view class="si-scan-outer-ring"></view>
        <view class="si-scan-ring"></view>
        <view class="si-scan-btn" role="button" aria-label="扫描出库单二维码" hover-class="si-press" bindtap="onScanTap">
          <view class="si-scan-icon">
            <view class="si-qr-corner si-qr-tl"><view class="si-qr-inner"></view></view>
            <view class="si-qr-corner si-qr-tr"><view class="si-qr-inner"></view></view>
            <view class="si-qr-corner si-qr-bl"><view class="si-qr-inner"></view></view>
            <view class="si-qr-dot d1"></view>
            <view class="si-qr-dot d2"></view>
            <view class="si-qr-dot d3"></view>
            <view class="si-qr-dot d4"></view>
            <view class="si-qr-dot d5"></view>
            <view class="si-qr-dot d6"></view>
            <view class="si-qr-dot d7"></view>
            <view class="si-scan-line"></view>
          </view>
          <text class="si-scan-btn-text">扫出库单二维码</text>
        </view>
      </view>
      <text class="si-idle-hint">扫描出库单右上角二维码，拍照留档后提交检验</text>
      <view class="si-example">
        <view class="si-example-heading"><text class="si-example-title">扫描示例</text><text class="si-example-zoom">点击图片放大</text></view>
        <text class="si-example-caption">对准橙色框标出的二维码</text>
        <image class="si-example-image" src="/assets/shipping-scan-example.png" mode="widthFix" bindtap="onPreviewScanExample" aria-label="出库单扫描示例，二维码位于右上角橙色框内" />
      </view>
    </view>

    <!-- loading -->
    <view class="si-hint" wx:if="{{state === 'loading'}}">
      <view class="si-spin"></view>
      <text class="si-hint-text">验签出库单…</text>
    </view>

    <!-- ready / submitting -->
    <block wx:if="{{state === 'ready' || state === 'submitting'}}">
      <!-- 单头卡片 -->
      <view class="si-record">
        <view class="si-record-head">
          <text class="si-record-no">{{record.outbound_no}}</text>
          <text class="si-badge {{submitted ? 'si-badge--done' : ''}}">{{statusText}}</text>
        </view>
        <text class="si-record-cust">{{record.customer_name}}</text>
        <text class="si-record-date">出库日期 {{record.outbound_date}}</text>
        <text class="si-record-remark">发货备注：{{record.remark || '无'}}</text>
        <text class="si-refresh" bindtap="onRefreshInspection">刷新状态及已上传内容</text>
      </view>

      <view class="si-readonly" wx:if="{{submitted}}">本单已提交检验，照片和视频只读。撤回后可刷新继续编辑。</view>

      <!-- 整单照片 -->
      <view class="si-section">
        <view class="si-section-head">
          <text class="si-section-title">整单照片</text>
          <text class="si-section-count">{{wholePhotos.length}} 张</text>
        </view>
        <scroll-view scroll-x class="si-photos" wx:if="{{wholePhotos.length > 0}}">
          <view class="si-thumb-wrap" wx:for="{{wholePhotos}}" wx:key="id"
                data-group="whole" data-index="{{index}}" data-photo-id="{{item.id}}"
                bindtap="onPreviewPhoto" bindlongpress="onDeletePhoto">
            <image wx:if="{{item.url}}" class="si-thumb" src="{{item.url}}" mode="aspectFill" />
            <view wx:else class="si-thumb si-thumb--loading"></view>
          </view>
        </scroll-view>
        <view class="si-capture-actions" wx:if="{{!submitted}}">
          <view class="si-camera-btn" bindtap="onWholeCameraTap" hover-class="si-press">拍整单照</view>
          <view class="si-camera-btn si-camera-btn--row" bindtap="onWholeVideoTap" hover-class="si-press">拍视频</view>
          <view class="si-camera-btn si-camera-btn--row" bindtap="onWholeAlbumVideoTap" hover-class="si-press">相册视频</view>
        </view>
        <view class="si-video-entry" wx:for="{{wholeVideos}}" wx:key="id">
          <text data-video-id="{{item.id}}" bindtap="onPreviewVideo">▶ 整单视频 {{index + 1}}</text>
          <text wx:if="{{!submitted}}" data-video-id="{{item.id}}" bindtap="onDeleteVideo">删除</text>
        </view>
        <text class="si-tip" wx:if="{{!submitted}}">拍摄或从相册选择后自动压缩上传，每段压缩后不超过100MB；提交至少需要1张照片</text>
        <text class="si-tip" wx:if="{{!submitted && wholePhotos.length > 0}}">点照片放大预览，长按可删除</text>
      </view>

      <!-- 出库明细：每行产品 + 数量 + 该行照片 -->
      <view class="si-item" wx:for="{{items}}" wx:key="item_id" wx:for-item="it">
        <view class="si-item-head">
          <text class="si-item-model">{{it.model}}</text>
          <view class="si-item-qty">
            <text class="si-qty-num">{{it.qty}}</text>
            <text class="si-qty-unit">{{it.unit}}</text>
          </view>
        </view>
        <text class="si-item-spec" wx:if="{{it.specText}}">{{it.specText}}</text>
        <scroll-view scroll-x class="si-photos" wx:if="{{it.photoCount > 0}}">
          <view class="si-thumb-wrap" wx:for="{{it.photos}}" wx:key="id" wx:for-item="ph"
                data-group="{{it.item_id}}" data-index="{{index}}" data-photo-id="{{ph.id}}"
                bindtap="onPreviewPhoto" bindlongpress="onDeletePhoto">
            <image wx:if="{{ph.url}}" class="si-thumb" src="{{ph.url}}" mode="aspectFill" />
            <view wx:else class="si-thumb si-thumb--loading"></view>
          </view>
        </scroll-view>
        <view class="si-capture-actions" wx:if="{{!submitted}}">
          <view class="si-camera-btn si-camera-btn--row" data-item-id="{{it.item_id}}" bindtap="onItemCameraTap"
                hover-class="si-press">拍照（{{it.photoCount}}张）</view>
          <view class="si-camera-btn si-camera-btn--row" data-item-id="{{it.item_id}}" bindtap="onItemVideoTap"
                hover-class="si-press">拍视频</view>
          <view class="si-camera-btn si-camera-btn--row" data-item-id="{{it.item_id}}" bindtap="onItemAlbumVideoTap" hover-class="si-press">相册视频</view>
        </view>
        <view class="si-video-entry" wx:for="{{it.videos}}" wx:key="id" wx:for-item="video">
          <text data-video-id="{{video.id}}" bindtap="onPreviewVideo">▶ 明细视频 {{index + 1}}</text>
          <text wx:if="{{!submitted}}" data-video-id="{{video.id}}" bindtap="onDeleteVideo">删除</text>
        </view>
      </view>

      <!-- 备注（选填） -->
      <view class="si-remark" wx:if="{{!submitted}}">
        <input class="si-remark-input" placeholder="检验备注（选填）" placeholder-class="si-remark-ph"
               value="{{remark}}" bindinput="onRemarkInput" />
      </view>

      <!-- 提交：显示已传照片总数，至少 1 张由后端校验兜底 -->
      <view class="si-footer" wx:if="{{!submitted}}">
        <view class="si-submit {{(state === 'submitting' || uploading) ? 'si-submit--disabled' : ''}}"
              bindtap="onSubmitTap" hover-class="si-press" hover-stay-time="80">
          {{state === 'submitting' ? '提交中…' : '提交检验（已传 ' + totalPhotos + ' 张）'}}
        </view>
      </view>
    </block>
  </view>

  <!-- 错误弹层 -->
  <view class="si-mask" wx:if="{{errorVisible}}" bindtap="onErrorTap">
    <view class="si-dialog" catchtap="noop">
      <text class="si-dialog-title">{{errorTitle}}</text>
      <text class="si-dialog-msg">{{errorMessage}}</text>
      <view class="si-dialog-btn" bindtap="onErrorTap">知道了</view>
    </view>
  </view>

  <result-toast visible="{{successVisible}}" type="success" title="{{successTitle}}"
                desc="{{successDesc}}" bind:close="onSuccessClose" />
</view>
