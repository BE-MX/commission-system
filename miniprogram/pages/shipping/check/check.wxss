/* pages/shipping/check/check.wxss — 发货检验
   深色顶栏（nav-bar 组件）+ 品牌黄 accent；车间抬眼能读：正文 ≥26rpx，
   单号 38rpx、数量 40rpx，与订单速查同一套字号纪律。 */

.si-page {
  min-height: 100vh;
  background: var(--gray-bg);
}

.si-body { padding-bottom: 60rpx; }

/* 按压反馈：只动 transform，140ms 回弹（与 entry 卡片同一套） */
.si-press {
  transform: scale(0.96);
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
}

/* ── idle：大扫码按钮 ── */
.si-idle {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx 0;
}

.si-scan-btn {
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: var(--brand-black);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.25);
}

/* 扫码图标：四角取景框，与报工页/速查页同一套线条语言 */
.si-scan-icon { width: 96rpx; height: 96rpx; position: relative; }

.si-c {
  position: absolute;
  width: 26rpx;
  height: 26rpx;
  border: 5rpx solid var(--brand-yellow);
}

.si-tl { top: 0; left: 0; border-right: none; border-bottom: none; }
.si-tr { top: 0; right: 0; border-left: none; border-bottom: none; }
.si-bl { bottom: 0; left: 0; border-right: none; border-top: none; }
.si-br { bottom: 0; right: 0; border-left: none; border-top: none; }

.si-scan-text { color: var(--brand-yellow); font-size: 34rpx; font-weight: 700; }

.si-idle-hint { margin-top: 40rpx; font-size: 26rpx; color: var(--text-muted); }

/* ── loading ── */
.si-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
}

.si-spin {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(0, 0, 0, 0.08);
  border-top-color: var(--brand-yellow-d);
  border-radius: 50%;
  animation: si-rotate 0.8s linear infinite;
}

@keyframes si-rotate { to { transform: rotate(360deg); } }

.si-hint-text { margin-top: 24rpx; font-size: 28rpx; color: var(--text-sub); }

/* ── 单头卡片 ── */
.si-record {
  margin: 28rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.si-record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.si-record-no { font-size: 38rpx; font-weight: 700; }

.si-badge {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--brand-yellow-bg);
  color: var(--brand-yellow-d);
  font-size: 24rpx;
  font-weight: 600;
}

.si-badge--done { background: var(--brand-green-bg); color: var(--brand-green-ink); }

.si-record-cust { display: block; margin-top: 12rpx; font-size: 30rpx; }
.si-record-date { display: block; margin-top: 6rpx; font-size: 26rpx; color: var(--text-muted); }

/* ── 已提交只读横幅 ── */
.si-readonly {
  margin: 20rpx 32rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: var(--brand-green-bg);
  color: var(--brand-green-ink);
  font-size: 26rpx;
  text-align: center;
}

/* ── 区块（整单照片 / 明细行）── */
.si-section, .si-item {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.si-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.si-section-title { font-size: 30rpx; font-weight: 700; }
.si-section-count { font-size: 26rpx; color: var(--text-muted); }

/* 照片横滑：缩略图等大方块，点击放大、长按删除（手势写进 si-tip 提示） */
.si-photos { margin-top: 18rpx; white-space: nowrap; }

.si-thumb-wrap {
  display: inline-block;
  width: 160rpx;
  height: 160rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #F0F1F3;
  vertical-align: top;
}

.si-thumb { width: 160rpx; height: 160rpx; }

.si-thumb--loading {
  /* 鉴权图 downloadFile 未回填前的占位，避免 <image src=""> 破图 */
  background: linear-gradient(135deg, #F0F1F3 0%, #E4E6EA 100%);
}

.si-camera-btn {
  margin-top: 18rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--brand-yellow);
  color: var(--brand-black);
  font-size: 30rpx;
  font-weight: 700;
}

/* 明细行的拍照按钮降一档：黄底黑字太重，整列都是会吵 */
.si-camera-btn--row {
  background: var(--brand-yellow-bg);
  border: 2rpx dashed var(--brand-yellow-d);
}

.si-tip { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--text-muted); }

/* ── 明细行 ── */
.si-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.si-item-name { flex: 1; min-width: 0; font-size: 32rpx; font-weight: 700; }

.si-item-qty { flex-shrink: 0; display: flex; align-items: baseline; }
.si-qty-num { font-size: 40rpx; font-weight: 700; }
.si-qty-unit { margin-left: 6rpx; font-size: 26rpx; color: var(--text-sub); }

.si-item-spec { display: block; margin-top: 8rpx; font-size: 26rpx; color: var(--text-muted); }

/* ── 备注 ── */
.si-remark { margin: 24rpx 32rpx 0; }

.si-remark-input {
  height: 88rpx;
  padding: 0 26rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.si-remark-ph { color: var(--text-muted); }

/* ── 提交 ── */
.si-footer { margin: 32rpx 32rpx 0; }

.si-submit {
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  border-radius: 20rpx;
  background: var(--brand-black);
  color: var(--brand-yellow);
  font-size: 34rpx;
  font-weight: 700;
}

.si-submit--disabled { opacity: 0.5; }

/* ── 错误弹层 ── */
.si-mask {
  position: fixed;
  inset: 0;
  z-index: 900;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.si-dialog {
  width: 560rpx;
  padding: 40rpx 36rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.si-dialog-title { font-size: 32rpx; font-weight: 700; }
.si-dialog-msg { margin-top: 16rpx; font-size: 28rpx; color: var(--text-sub); text-align: center; }

.si-dialog-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--brand-black);
  color: var(--brand-yellow);
  font-size: 30rpx;
  font-weight: 700;
}
