# Ark origin must be HTTPS outside localhost. MCP must remain same-origin.
ARK_BASE_URL=https://ark.example.com
ARK_MCP_URL=https://ark.example.com/mcp

# Machine identity. Keep the plaintext token only in the Worker environment file;
# configure only its SHA-256 in backend AGENT_RUNTIME_WORKER_TOKEN_HASHES_JSON,
# and bind this ID with AGENT_RUNTIME_WORKER_RUNTIMES_JSON={"dsh-worker-01":["dsh"]}.
ARK_AGENT_WORKER_ID=dsh-worker-01
ARK_AGENT_WORKER_TOKEN=replace-with-at-least-32-random-characters

ARK_DSH_SESSION_ROOT=/var/lib/leshine-ark-dsh/sessions
ARK_AGENT_POLL_SECONDS=5
ARK_AGENT_HEARTBEAT_SECONDS=45
ARK_AGENT_HTTP_TIMEOUT_SECONDS=30
DSH_SDK_EXPECTED_VERSION=0.1.0rc8
