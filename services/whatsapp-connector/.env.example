PORT=8787
WHATSAPP_CONNECTOR_HOST=127.0.0.1
WHATSAPP_CONNECTOR_API_KEY=
ARK_API_BASE_URL=http://127.0.0.1:8001
WHATSAPP_PROVIDER=baileys
# Optional HTTP(S) CONNECT proxy for WhatsApp socket/media only; Ark callback stays direct.
WHATSAPP_PROXY_URL=
WHATSAPP_DATA_DIR=./data
WHATSAPP_RESTORE_ON_START=true
# Required: external secret, canonical base64 encoding of exactly 32 random bytes.
# Keep it separate from SQLite state and backups. Changing the version alone cannot rotate existing rows.
WHATSAPP_ENCRYPTION_KEY=
WHATSAPP_KEY_VERSION=1
# Account/store records are retained until an explicitly approved retention/migration operation.
# Reaching either bound pauses collection with a visible coverage gap; no silent eviction.
WHATSAPP_MAX_DISK_BYTES=1073741824
WHATSAPP_MAX_CHANGE_ROWS=1000000
