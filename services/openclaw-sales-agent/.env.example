# Runtime file: ~/.openclaw-ark-sales/.env (mode 0600)
# The bootstrap script generates OPENCLAW_GATEWAY_TOKEN automatically.
OPENCLAW_GATEWAY_TOKEN=

# Ark endpoint and fixed trust boundary. Keep these origins identical.
ARK_BASE_URL=https://leshine.work
ARK_ALLOWED_ORIGIN=https://leshine.work
ARK_AGENT_ID=openclaw-sales-01
ARK_API_TIMEOUT_MS=30000

# Store the Ark token as the only line in this separate 0600 file:
# ~/.openclaw-ark-sales/secrets/ark-agent-token

# Required by the hardened built-in OpenClaw runtime (current default provider).
DEEPSEEK_API_KEY=
# Alternative providers require changing the default model and keeping an
# explicit model-scoped `agentRuntime: { id: "openclaw" }` pin.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# MVP defaults to the key-free official Parallel Search plugin + local web_fetch.
# Optional paid search/fetch upgrades:
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# FIRECRAWL_API_KEY=
